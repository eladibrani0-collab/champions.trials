<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>MOODIFY — Creative Universe</title>

<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
<link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700;800&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="style.css">
<script src="https://cdn.jsdelivr.net/npm/html2canvas@1.4.1/dist/html2canvas.min.js" defer></script>
<script src="js/main.js" defer></script>
</head>

<body>
<div class="ambient ambient-one"></div>
<div class="ambient ambient-two"></div>

<!-- SIDEBAR -->
<aside class="sidebar">
<a href="#" class="brand" onclick="showPage('home');return false">
<span class="brand-symbol">
<img src="photo.jpg" alt="MOODIFY Logo" class="moodify-logo">
</span>
<span>MOODIFY<span class="brand-dot">.</span></span>
</a>

<div class="side-label">WORKSPACE</div>

<button class="nav-item active" data-page="home" onclick="showPage('home')">
<i class="bi bi-grid-1x2-fill"></i> Overview
</button>
<button class="nav-item" data-page="studio" onclick="showPage('studio')">
<i class="bi bi-palette-fill"></i> Creative Studio
</button>
<button class="nav-item" data-page="discover" onclick="showPage('discover')">
<i class="bi bi-compass"></i> Discover
</button>

<div class="side-label">ENTERTAINMENT</div>
<button class="nav-item" data-page="arcade" onclick="showPage('arcade')">
<i class="bi bi-controller"></i> Moodify Arcade
<span class="new-tag">NEW</span>
</button>

<div class="side-label">PERSONAL</div>
<button class="nav-item" data-page="collection" onclick="showPage('collection')">
<i class="bi bi-bookmark-heart"></i> My Collection
</button>
<button class="nav-item" data-page="profile" onclick="showPage('profile')">
<i class="bi bi-person-circle"></i> My Profile
</button>

<div class="sidebar-bottom">
<div class="pro-card">
<i class="bi bi-stars"></i>
<h6>Stay inspired.</h6>
<p>Your creativity has no limits.</p>
</div>
<small>MOODIFY © 2026</small>
</div>
</aside>

<!-- MAIN CONTENT -->
<main class="main-content">

<header class="topbar">
<div>
<span class="top-kicker">YOUR CREATIVE UNIVERSE</span>
<h5 id="pageHeading">Overview</h5>
</div>
<div class="top-actions">
<div class="online-status"><span></span> STUDIO ONLINE</div>
<button class="profile-button" onclick="showPage('profile')">
<i class="bi bi-person-fill"></i>
</button>
</div>
</header>

<!-- HOME PAGE -->
<section class="page active" id="home">
<div class="welcome-banner">
<div class="welcome-content">
<span class="hero-tag">CREATIVITY STARTS HERE</span>
<h1>Imagine it.<br><span>Create it.</span></h1>
<p>A space where your ideas become visual experiences.</p>
<button class="main-button" onclick="showPage('studio')">
Enter Creative Studio <i class="bi bi-arrow-up-right"></i>
</button>
</div>
<div class="hero-decoration">
<div class="orb orb-one"></div>
<div class="orb orb-two"></div>
<div class="orb orb-three"></div>
<div class="hero-center"><i class="bi bi-stars"></i></div>
</div>
</div>

<div class="section-title">
<div>
<span class="top-kicker">YOUR ACTIVITY</span>
<h2>Creative overview</h2>
</div>
<span class="live-badge">● LIVE DASHBOARD</span>
</div>

<div class="stats-grid">
<div class="stat-card">
<i class="bi bi-grid-3x3-gap"></i>
<span>BOARDS CREATED</span>
<h2 id="statBoards">0</h2>
<small>Your creative universe</small>
</div>
<div class="stat-card">
<i class="bi bi-controller"></i>
<span>GAMES PLAYED</span>
<h2 id="statGames">0</h2>
<small>Time to challenge yourself</small>
</div>
<div class="stat-card">
<i class="bi bi-trophy"></i>
<span>ARCADE SCORE</span>
<h2 id="statScore">0</h2>
<small>Your total points</small>
</div>
<div class="stat-card">
<i class="bi bi-lightning-charge"></i>
<span>CREATIVE LEVEL</span>
<h2 id="statLevel">01</h2>
<small>Keep exploring</small>
</div>
</div>

<div class="section-title mt-5">
<div>
<span class="top-kicker">EXPLORE MORE</span>
<h2>Choose your experience</h2>
</div>
</div>

<div class="feature-grid">
<div class="feature-card studio-feature" onclick="showPage('studio')">
<div class="feature-icon"><i class="bi bi-palette"></i></div>
<span>01 / CREATE</span>
<h3>Creative Studio</h3>
<p>Design something extraordinary.</p>
<i class="bi bi-arrow-up-right feature-arrow"></i>
</div>
<div class="feature-card arcade-feature" onclick="showPage('arcade')">
<div class="feature-icon"><i class="bi bi-controller"></i></div>
<span>02 / PLAY</span>
<h3>Arcade</h3>
<p>Challenge your creative instincts.</p>
<i class="bi bi-arrow-up-right feature-arrow"></i>
</div>
<div class="feature-card discover-feature" onclick="showPage('discover')">
<div class="feature-icon"><i class="bi bi-compass"></i></div>
<span>03 / EXPLORE</span>
<h3>Discover</h3>
<p>Find your next inspiration.</p>
<i class="bi bi-arrow-up-right feature-arrow"></i>
</div>
</div>
</section>

<!-- CREATIVE STUDIO PAGE -->
<section class="page" id="studio">
<div class="page-intro">
<span class="top-kicker">THE DESIGN LAB</span>
<h1>Make your <span>vision.</span></h1>
<p>Build a visual world that represents your imagination.</p>
</div>

<div class="studio-layout">
<div class="editor-panel">
<h4><i class="bi bi-sliders"></i> Design Controls</h4>

<label for="boardTitle">BOARD TITLE</label>
<input id="boardTitle" class="dark-input" placeholder="My creative universe">

<label for="themeSelect">SELECT AESTHETIC</label>
<select id="themeSelect" class="dark-input">
<option value="minimal">Minimalist</option>
<option value="luxury">Luxury</option>
<option value="summer">Summer</option>
<option value="dark">Dark Academia</option>
<option value="pastel">Pastel Dreams</option>
<option value="cyber">Cyberpunk</option>
</select>

<label for="customColor">ACCENT COLOR</label>
<input type="color" id="customColor" value="#a98aff">

<button class="main-button full-button" onclick="generateBoard()">
<i class="bi bi-stars"></i> Generate Board
</button>
<button class="secondary-button" onclick="randomizeColor()">
<i class="bi bi-shuffle"></i> Randomize Colors
</button>

<label class="upload-label" for="imageUpload">
<i class="bi bi-cloud-upload"></i> Upload your own image
</label>
<input type="file" id="imageUpload" accept="image/*" hidden>

<hr>

<button class="secondary-button" onclick="saveBoard()">
<i class="bi bi-bookmark"></i> Save Board
</button>
<button class="secondary-button" onclick="downloadBoard()">
<i class="bi bi-download"></i> Export as PNG
</button>

<small class="editor-tip">
<i class="bi bi-info-circle"></i>
Drag the cards to rearrange your composition.
</small>
</div>

<div class="canvas-area">
<div class="canvas-toolbar">
<span><i class="bi bi-circle-fill"></i> DESIGN CANVAS</span>
<span>DRAG TO REARRANGE</span>
</div>

<div class="mood-board" id="moodBoard">
<div class="board-top">
<div>
<small>MOODIFY / ORIGINAL SERIES</small>
<h2 id="displayTitle">My Creative Universe</h2>
</div>
<span id="boardDate"></span>
</div>
<div class="mood-grid" id="moodGrid"></div>
<div class="board-bottom">
<span>MOODIFY CREATIVE STUDIO</span>
<span>DESIGNED WITH IMAGINATION ✦</span>
</div>
</div>

<p class="canvas-hint">✦ Every creation is uniquely yours.</p>
</div>
</div>
</section>

<!-- DISCOVER PAGE -->
<section class="page" id="discover">
<div class="page-intro">
<span class="top-kicker">THE INSPIRATION LIBRARY</span>
<h1>Discover your <span>aesthetic.</span></h1>
<p>Explore different visual worlds and find your next idea.</p>
</div>

<div class="discover-grid">
<div class="discover-card" style="--card-image:url('https://images.unsplash.com/photo-1494438639946-1ebd1d20bf85?w=900')">
<div><span>01 / SIMPLICITY</span><h2>Minimal Living</h2></div>
<button onclick="selectAesthetic('minimal')">Explore <i class="bi bi-arrow-up-right"></i></button>
</div>
<div class="discover-card" style="--card-image:url('https://images.unsplash.com/photo-1616486338812-3dadae4b4ace?w=900')">
<div><span>02 / ELEGANCE</span><h2>Quiet Luxury</h2></div>
<button onclick="selectAesthetic('luxury')">Explore <i class="bi bi-arrow-up-right"></i></button>
</div>
<div class="discover-card" style="--card-image:url('https://images.unsplash.com/photo-1470252649378-9c29740c9fa8?w=900')">
<div><span>03 / FREEDOM</span><h2>Summer Escape</h2></div>
<button onclick="selectAesthetic('summer')">Explore <i class="bi bi-arrow-up-right"></i></button>
</div>
<div class="discover-card" style="--card-image:url('https://images.unsplash.com/photo-1513519245088-0e12902e5a38?w=900')">
<div><span>04 / IMAGINATION</span><h2>Pastel Dreams</h2></div>
<button onclick="selectAesthetic('pastel')">Explore <i class="bi bi-arrow-up-right"></i></button>
</div>
<div class="discover-card" style="--card-image:url('https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=900')">
<div><span>05 / MYSTERY</span><h2>Dark Academia</h2></div>
<button onclick="selectAesthetic('dark')">Explore <i class="bi bi-arrow-up-right"></i></button>
</div>
<div class="discover-card" style="--card-image:url('https://images.unsplash.com/photo-1519608487953-e999c86e7455?w=900')">
<div><span>06 / FUTURE</span><h2>Cyber World</h2></div>
<button onclick="selectAesthetic('cyber')">Explore <i class="bi bi-arrow-up-right"></i></button>
</div>
</div>
</section>

<!-- ARCADE PAGE -->
<section class="page" id="arcade">
<div class="page-intro arcade-intro">
<span class="top-kicker">MOODIFY ENTERTAINMENT SYSTEM</span>
<h1>Enter the <span>Arcade.</span></h1>
<p>Think fast. Test your memory. Master colors.</p>
</div>

<div class="arcade-stats">
<div><small>YOUR SCORE</small><h2 id="arcadeScore">0</h2></div>
<div><small>GAMES PLAYED</small><h2 id="arcadeGames">0</h2></div>
<div><small>YOUR RANK</small><h2 id="arcadeRank">ROOKIE</h2></div>
</div>

<div class="game-selector">
<button class="game-choice active" onclick="selectGame('reaction',this)">
<i class="bi bi-bullseye"></i>
<h4>Reaction Challenge</h4>
<p>Catch the moving target.</p>
<span>PLAY NOW</span>
</button>
<button class="game-choice" onclick="selectGame('memory',this)">
<i class="bi bi-grid-3x3-gap-fill"></i>
<h4>Memory Flip</h4>
<p>Match all the hidden pairs.</p>
<span>PLAY NOW</span>
</button>
<button class="game-choice" onclick="selectGame('palette',this)">
<i class="bi bi-droplet-half"></i>
<h4>Palette Master</h4>
<p>Guess the correct color.</p>
<span>PLAY NOW</span>
</button>
</div>

<!-- REACTION CHALLENGE -->
<div class="game-arena" id="reactionGame">
<div class="game-heading">
<div>
<span class="top-kicker">REACTION CHALLENGE / 001</span>
<h2>Reaction Challenge</h2>
<p>Catch the moving target before time runs out.</p>
</div>
<div class="game-level">HITS <span id="reactionHits">0</span></div>
</div>

<div class="timer-track"><div id="reactionTimerBar"></div></div>

<div class="reaction-info">
<span>TIME LEFT: <strong id="reactionTime">20</strong>s</span>
<span>SCORE: <strong id="reactionScore">0</strong></span>
</div>

<div class="reaction-field" id="reactionField">
<button class="reaction-target hidden" id="reactionTarget"
onclick="hitReactionTarget()" aria-label="Hit target"></button>
<div class="reaction-placeholder" id="reactionPlaceholder">
PRESS START TO BEGIN
</div>
</div>

<div class="game-message" id="reactionMessage">
Get as many hits as you can in 20 seconds.
</div>
<button class="main-button" onclick="startReactionGame()">
<i class="bi bi-play-fill"></i> START CHALLENGE
</button>
</div>

<!-- MEMORY FLIP -->
<div class="game-arena hidden" id="memoryGame">
<div class="game-heading">
<div>
<span class="top-kicker">MEMORY CHALLENGE / 002</span>
<h2>Memory Flip</h2>
<p>Find every matching pair.</p>
</div>
<div class="game-level">MOVES <span id="memoryMoves">0</span></div>
</div>

<div class="memory-board" id="memoryBoard"></div>
<div class="game-message" id="memoryMessage">
Flip the cards and find the matching pairs.
</div>
<button class="main-button" onclick="startMemoryGame()">
<i class="bi bi-arrow-clockwise"></i> NEW GAME
</button>
</div>

<!-- PALETTE MASTER -->
<div class="game-arena hidden" id="paletteGame">
<div class="game-heading">
<div>
<span class="top-kicker">PALETTE CHALLENGE / 003</span>
<h2>Palette Master</h2>
<p>Choose the correct HEX color from four options.</p>
</div>
<div class="game-level">QUESTION <span id="paletteQuestion">0/5</span></div>
</div>

<div class="palette-target">
<small>FIND THIS HEX CODE</small>
<h2 id="paletteHex">#A98AFF</h2>
</div>
<div class="color-options" id="paletteOptions"></div>
<div class="game-message" id="paletteMessage">
Press START to begin your challenge.
</div>
<button class="main-button" onclick="startPaletteGame()">
<i class="bi bi-play-fill"></i> START CHALLENGE
</button>
</div>
</section>

<!-- COLLECTION PAGE -->
<section class="page" id="collection">
<div class="page-intro">
<span class="top-kicker">YOUR PERSONAL ARCHIVE</span>
<h1>Made by <span>you.</span></h1>
<p>Your ideas, saved in one beautiful place.</p>
</div>
<div class="collection-grid" id="savedBoards"></div>
</section>

<!-- PROFILE PAGE -->
<section class="page" id="profile">
<div class="page-intro">
<span class="top-kicker">YOUR CREATIVE IDENTITY</span>
<h1>The <span>Creator.</span></h1>
<p>Your personal journey through the MOODIFY universe.</p>
</div>

<div class="profile-card">
<div class="profile-avatar"><i class="bi bi-person-fill"></i></div>
<span class="top-kicker">CREATIVE MEMBER</span>
<h2>Creative Explorer</h2>
<p>Building worlds, one idea at a time.</p>
<div class="profile-rank">✦ <span id="profileRank">ROOKIE</span> ✦</div>
</div>

<div class="stats-grid profile-stats">
<div class="stat-card"><span>BOARDS</span><h2 id="profileBoards">0</h2></div>
<div class="stat-card"><span>GAMES</span><h2 id="profileGames">0</h2></div>
<div class="stat-card"><span>TOTAL SCORE</span><h2 id="profileScore">0</h2></div>
<div class="stat-card"><span>LEVEL</span><h2 id="profileLevel">01</h2></div>
</div>

<div class="achievement-panel">
<h3><i class="bi bi-award"></i> Achievements</h3>
<div id="achievements"></div>
</div>
</section>

<footer class="site-footer">
<span>MOODIFY<span class="brand-dot">.</span></span>
<p>CREATIVITY HAS NO LIMITS.</p>
<small>© 2026 MOODIFY CREATIVE UNIVERSE</small>
</footer>
</main>

<div id="toast" class="toast-message"></div>
</body>
</html>
